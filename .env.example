# ============================================================
# AI Development Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
POSTGRES_DB=ai_agent
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AI Provider (Gemini) ----
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- GitHub ----
# Fine-grained PAT with: contents:write, pull_requests:write
# Get yours at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# ---- Workspace ----
WORKSPACE_ROOT=/workspaces

# ---- Security: Repository Allowlist ----
# Comma-separated list. Glob patterns supported.
# Example: github.com/myorg/*,github.com/specificuser/specificrepo
REPOSITORY_ALLOWLIST=

# ---- Webhooks (Day 4) ----
JIRA_WEBHOOK_SECRET=
TRELLO_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
