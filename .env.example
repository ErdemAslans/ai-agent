# ============================================================
# AI Development Agent — Environment Variables
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env to git.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.io,.ngrok.app
DJANGO_LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
POSTGRES_DB=ai_agent
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AI Provider (Gemini) ----
# Get yours at https://aistudio.google.com/app/apikey (free tier is enough).
GEMINI_API_KEY=

# ---- GitHub ----
# Fine-grained PAT with: Contents R/W, Pull requests R/W.
# Create at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional per-owner overrides. Comma-separated list of owner:token.
# Example: orgA:ghp_aaa,orgB:ghp_bbb
GITHUB_TOKEN_MAP=

# ---- Workspace ----
WORKSPACE_ROOT=/workspaces

# ---- Security ----
# Comma-separated glob patterns. Empty list = accept all (dev mode).
# Example: github.com/myorg/*,github.com/specificuser/specificrepo
REPOSITORY_ALLOWLIST=

# ---- Test runner mode ----
# "subprocess" (default) runs tests in the worker container.
# "docker" spawns an isolated Docker container per run (network=none, 512m).
#   Requires /var/run/docker.sock mounted in the worker.
TEST_RUNNER_MODE=subprocess

# ---- Celery monitoring (Flower) ----
# The dev compose runs Flower at http://localhost:5555 with NO auth.
# For production: drop an nginx reverse proxy with basic auth in front of
# this port, or set FLOWER_BASIC_AUTH=user:password and uncomment the
# matching env block in docker-compose.yml's flower service.
# FLOWER_BASIC_AUTH=admin:replace-me

# ---- Webhook signing secrets (optional) ----
# When set, the matching endpoint requires a valid HMAC SHA-256 signature
# (Jira: X-Hub-Signature, Trello: X-Trello-Webhook, GitHub: X-Hub-Signature-256).
# Empty => verification bypassed for dev/simulation.
JIRA_WEBHOOK_SECRET=
TRELLO_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://langfuse:3000

# ---- ngrok (optional, only needed to expose webhooks to real Jira/Trello/GitHub) ----
# Get your free authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
